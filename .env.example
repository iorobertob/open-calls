# Template: copy to .env and fill in.
# MISC open calls settings. Git-ignored: each copy stays where it is (nothing uploads it).
#   - on your computer: .env next to the code, for local development
#   - on the server:    /var/www/open-calls/.env — deploy/install.sh enforces the production values
#     (DEV_LOGIN=0, APP_PREFIX=/open-calls, PUBLIC_BASE_URL, HTTPS cookies, a strong SECRET_KEY)

# ---- Local-only values (set automatically on the server) ---------------------------------------------
SECRET_KEY=change-me-for-local-use
# log in without Microsoft at /auth/dev-login (only with --debug)
DEV_LOGIN=1
PUBLIC_BASE_URL=http://localhost:5055

# ---- Microsoft Entra ID (LMTA tenant) --------------------------------------------------------
# Entra admin centre → App registrations → your app. Redirect URIs to register:
#   http://localhost:5055/auth/callback                (local)
#   https://misc.lmta.lt/open-calls/auth/callback      (production)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
ALLOWED_EMAIL_DOMAINS=lmta.lt
# comma-separated; these accounts become admins on login
ADMIN_EMAILS=admin@lmta.lt

# ---- MailerLite (deadline reminder emails) ---------------------------------------------------
# Emails are sent once both values are set; until then reminders are only written to the log.
# MailerLite → Integrations → MailerLite API → Generate new token
MAILERLITE_API_KEY=
# printed by: flask mailerlite-setup
MAILERLITE_REMINDER_GROUP_ID=
REMINDER_DAYS_BEFORE=7

# ---- Claude API (add-by-link, re-checks, translations) ---------------------------------------
ANTHROPIC_API_KEY=
# Only if Claude reports "This API key is not scoped to a workspace": the workspace ID (wrkspc_…)
# from console.anthropic.com → Settings → Workspaces. Not needed for keys created inside a workspace.
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ---- Optional -----------------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://opencalls:PASSWORD@localhost/opencalls   # default: SQLite
