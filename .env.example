# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# SQLite by default; for production e.g. postgresql+psycopg://opencalls:PASSWORD@localhost/opencalls
# DATABASE_URL=

# Microsoft Entra ID app registration in the LMTA tenant
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
ALLOWED_EMAIL_DOMAINS=lmta.lt
ADMIN_EMAILS=
# Local development only: log in without Microsoft at /auth/dev-login
DEV_LOGIN=0

# Claude API for "add by link" and periodic re-checks (optional; basic extraction without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

REFRESH_BATCH=40
REFRESH_MIN_AGE_DAYS=7
ARCHIVE_AFTER_DAYS=14
ENABLE_SCHEDULER=0

# Production behind HTTPS
SESSION_COOKIE_SECURE=0
PREFERRED_URL_SCHEME=http
ICS_UID_DOMAIN=misc.lmta.lt
