# Weekly: archive expired entries, fill missing translations, re-check the pages of current calls,
# scan series pages for new calls, keep "expected next call" placeholders
[Unit]
Description=MISC open calls: weekly refresh

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=FLASK_APP=wsgi.py
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__APP_DIR__/.venv/bin/flask refresh
