# Daily e-mails over SMTP: deadline reminders (1 month before, then weekly), new calls in followed
# series, changes to subscribed calls, and the admin digest of entries to review
[Unit]
Description=MISC open calls: daily e-mail notifications

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=FLASK_APP=wsgi.py
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__APP_DIR__/.venv/bin/flask send-notifications
